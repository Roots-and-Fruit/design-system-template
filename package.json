{
  "name": "design-system-template",
  "private": true,
  "description": "Forkable core design system template. Edit brand.json, then npm run customize.",
  "scripts": {
    "customize": "node scripts/apply-brand.mjs",
    "sync:design-md": "node sync-design-md-embed.mjs",
    "compile:wordpress": "node scripts/compile-wordpress.mjs && node scripts/verify-wordpress.mjs",
    "sync:theme": "node scripts/sync-theme.mjs",
    "test:wp": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0"
  },
  "engines": {
    "node": ">=18"
  }
}
