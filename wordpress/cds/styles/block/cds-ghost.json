{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "slug": "cds-ghost",
  "title": "Ghost",
  "blockTypes": [
    "core/button"
  ],
  "styles": {
    "border": {
      "radius": "var:custom|button|radius",
      "style": "solid",
      "width": "1.5px",
      "color": "transparent"
    },
    "color": {
      "background": "transparent",
      "text": "var:preset|color|ink-muted"
    },
    ":hover": {
      "color": {
        "background": "var:preset|color|primary-soft",
        "text": "var:preset|color|ink-muted"
      }
    }
  }
}
